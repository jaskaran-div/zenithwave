# Contact form email (Hostinger email SMTP). Copy to .env.local for local dev,
# and add the same variables in Hostinger → Web App → Environment variables.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@zenithwavecapital.com
SMTP_PASS=your-mailbox-password
# Where contact form messages are delivered (defaults to support@zenithwavecapital.com)
CONTACT_TO=support@zenithwavecapital.com
